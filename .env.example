# The impostor's credentials, read by `npm run impostor:server`.
#
# Copy to `.env` and fill it in. `.env` is gitignored; this file is the
# template and must never hold a real key.
#
# The key lives in the server process only. The app never sees it — that is
# the whole reason `server/index.js` exists.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Defaults to google/gemma-4-31b-it:free.
# OPENROUTER_MODEL=google/gemma-4-31b-it

# Optional. Precision floor for provider routing on the PAID model — cheapest
# provider that meets it wins. Empty string allows anything, including fp4.
# Irrelevant on `:free`, which has one provider. Default: bf16,fp8
# OPENROUTER_QUANTIZATIONS=bf16,fp8

# Optional. Comma-separated models to try when the first is rate-limited.
# A second model is a second writing voice — see the note in server/impostor.js.
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free

# Optional. How OpenRouter's dashboard labels this traffic.
# OPENROUTER_SITE_NAME=An Impostor

# Where the app finds the server. Printed when the server starts.
# EXPO_PUBLIC_IMPOSTOR_URL=http://192.168.1.10:8787
